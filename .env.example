# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these values are repository secrets.

# Cloudflare R2 (S3-compatible API) – only needed for upload
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public base URL of the bucket (used in index.json), e.g. https://radar.meteocam.ch
PUBLIC_BASE_URL=

# MeteoSwiss STAC API
STAC_URL=https://data.geo.admin.ch/api/stac/v1
